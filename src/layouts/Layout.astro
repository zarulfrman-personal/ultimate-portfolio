---
import "@/styles/starwind.css";
import '../styles/global.css';
import { portfolio, projects } from '../data/portfolio';
import { Image } from 'astro:assets';
import shoppingCart from '../assets/shopping-cart.svg';
import portfolioIcon from '../assets/portfolio-bodega.svg';
import currencyIcon from '../assets/currency-svg.svg';
import arrowDownIcon from '../assets/arrow-down-svg.svg';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = `${portfolio.name} — Portfolio`,
	description = portfolio.introduction,
} = Astro.props;
const catalog = projects.map(({ slug, title, price }) => ({ slug, title, price }));
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={portfolioIcon.src} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ffffff" />
		<title>{title}</title>
		<script is:inline>
			try {
				if (localStorage.getItem('portfolio-shop-theme') === 'night') {
					document.documentElement.classList.add('dark');
				}
			} catch {
				document.documentElement.dataset.themeStorage = 'unavailable';
			}
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<div class="site-shell">
			<header class="site-header">
				<a class="wordmark" href="/" aria-label={`${portfolio.name} home`}>
					<img class="wordmark-mark" src={portfolioIcon.src} alt="" width="36" height="36" />
					<span>{portfolio.name}<small>BODEGA PORTFOLIO</small></span>
				</a>
				<nav class="main-nav" aria-label="Main navigation">
					<a class="nav-link" href="/#catalog" aria-current={currentPath === '/' || currentPath.startsWith('/projects/') ? 'page' : undefined}>Work</a>
					<a class="nav-link" href="/about/" aria-current={currentPath === '/about/' ? 'page' : undefined}>About</a>
					<a class="nav-link" href="/resume/" aria-current={currentPath === '/resume/' ? 'page' : undefined}>Resume</a>
					<a class="nav-link" href="/contact/" aria-current={currentPath === '/contact/' ? 'page' : undefined}>Contact</a>
					<a class="nav-link" href="/resources/" aria-current={currentPath === '/resources/' ? 'page' : undefined}>Resources</a>
				</nav>
				<div class="header-actions">
					<div class="currency-picker">
						<button class="currency-trigger" id="currency-trigger" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="currency-menu" aria-label="Display currency: MYR">
							<Image src={currencyIcon} alt="" width={19} height={19} class="currency-symbol" />
							<span id="currency-current">MYR</span>
							<Image src={arrowDownIcon} alt="" width={12} height={12} class="currency-caret" />
						</button>
						<div class="currency-menu" id="currency-menu" role="menu" aria-label="Choose display currency" hidden>
							<button type="button" role="menuitemradio" aria-checked="true" data-currency-option="MYR">MYR <span>Malaysian ringgit</span></button>
							<button type="button" role="menuitemradio" aria-checked="false" data-currency-option="USD">USD <span>US dollar</span></button>
							<button type="button" role="menuitemradio" aria-checked="false" data-currency-option="EUR">EUR <span>Euro</span></button>
							<button type="button" role="menuitemradio" aria-checked="false" data-currency-option="GBP">GBP <span>British pound</span></button>
						</div>
						<select class="currency-native-select" id="currency-select" aria-hidden="true" tabindex="-1">
							<option value="MYR" selected>MYR</option>
							<option value="USD">USD</option>
							<option value="EUR">EUR</option>
							<option value="GBP">GBP</option>
						</select>
					</div>
					<button class="theme-toggle" id="theme-toggle" type="button" aria-pressed="false" aria-label="Switch to night mode">
						<svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.1A8.3 8.3 0 0 1 8.9 3.8 8.5 8.5 0 1 0 20.2 15.1Z"></path></svg>
						<svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path></svg>
						<span class="theme-label">Night</span>
					</button>
					<button class="bag-trigger" type="button" aria-expanded="false" aria-controls="bag-panel" aria-label="Open cart">
						<Image src={shoppingCart} alt="" width={20} height={20} class="cart-icon" />
						<span>Cart</span>
						<span class="bag-count" id="bag-count" aria-live="polite">0</span>
					</button>
				</div>
			</header>

			<main id="main-content">
				<slot />
			</main>

			<footer class="site-footer">
				<a class="footer-wordmark" href="/">{portfolio.name}<span>© {new Date().getFullYear()}</span></a>
				<p>Software, systems, and ideas made with care.</p>
				<div class="footer-links">
					<a href="/resources/">Resources <span aria-hidden="true">↗</span></a>
					<a href="/contact/">Let’s connect <span aria-hidden="true">↗</span></a>
				</div>
			</footer>
		</div>

		<div class="bag-backdrop" data-bag-close hidden></div>
		<aside class="bag-panel" id="bag-panel" aria-label="Shopping cart" aria-hidden="true" inert>
			<div class="bag-panel-head">
				<div>
					<p class="eyebrow">YOUR CART</p>
					<h2>Projects in your cart <span id="bag-heading-count">(0)</span></h2>
				</div>
				<button class="icon-button" type="button" data-bag-close aria-label="Close shopping cart">×</button>
			</div>
			<p class="bag-hint">A little collection of projects to explore. Nothing to pay—just free to peek.</p>
			<div class="bag-items" id="bag-items" data-projects={JSON.stringify(catalog)}></div>
			<p class="bag-empty" id="bag-empty">Your cart is empty. Add a project that catches your eye.</p>
			<div class="bag-total"><span>Subtotal</span><strong id="bag-subtotal">RM 0.00</strong></div>
			<p class="bag-free-note"><span aria-hidden="true">✓</span> Every project is free to peek</p>
			<a class="button button-dark bag-contact" href="/#catalog">Continue browsing <span aria-hidden="true">↗</span></a>
		</aside>

		<script>
			const siteHeader = document.querySelector<HTMLElement>('.site-header');
			if (siteHeader) {
				const updateHeaderScrollState = () => {
					siteHeader.classList.toggle('is-scrolled', window.scrollY > 8);
				};
				window.addEventListener('scroll', updateHeaderScrollState, { passive: true });
				updateHeaderScrollState();
			}

			const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
			const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

			if (themeToggle) {
				const updateThemeControl = () => {
					const isNight = document.documentElement.classList.contains('dark');
					themeToggle.setAttribute('aria-pressed', String(isNight));
					themeToggle.setAttribute('aria-label', `Switch to ${isNight ? 'day' : 'night'} mode`);
					themeToggle.querySelector<HTMLElement>('.theme-label')!.textContent = isNight ? 'Day' : 'Night';
					if (themeColor) themeColor.content = isNight ? '#171714' : '#faf8f3';
				};

				themeToggle.addEventListener('click', () => {
					const isNight = document.documentElement.classList.toggle('dark');
					updateThemeControl();
					try {
						localStorage.setItem('portfolio-shop-theme', isNight ? 'night' : 'day');
						themeToggle.removeAttribute('title');
					} catch {
						themeToggle.title = 'Theme preference could not be saved in this browser.';
					}
				});
				updateThemeControl();
				if (document.documentElement.dataset.themeStorage === 'unavailable') {
					themeToggle.title = 'Theme preference could not be loaded in this browser.';
				}
			}

			const currencySelect = document.querySelector<HTMLSelectElement>('#currency-select');
			const currencyTrigger = document.querySelector<HTMLButtonElement>('#currency-trigger');
			const currencyCurrent = document.querySelector<HTMLElement>('#currency-current');
			const currencyMenu = document.querySelector<HTMLElement>('#currency-menu');
			const currencyOptions = document.querySelectorAll<HTMLButtonElement>('[data-currency-option]');
			let currentCurrency = 'MYR';
			if (currencySelect) {
				const supportedCurrencies = ['MYR', 'USD', 'EUR', 'GBP'];
				try {
					const savedCurrency = localStorage.getItem('portfolio-shop-currency');
					if (savedCurrency && supportedCurrencies.includes(savedCurrency)) {
						currencySelect.value = savedCurrency;
					}
					currentCurrency = currencySelect.value;
				} catch {
					currencySelect.title = 'Currency preference could not be loaded in this browser.';
				}
			}
			const updateCurrencyControl = () => {
				if (!currencySelect || !currencyTrigger || !currencyCurrent) return;
				currencyCurrent.textContent = currencySelect.value;
				currencyTrigger.setAttribute('aria-label', `Display currency: ${currencySelect.value}`);
				currencyOptions.forEach((option) => {
					const selected = option.dataset.currencyOption === currencySelect.value;
					option.setAttribute('aria-checked', String(selected));
				});
			};
			const closeCurrencyMenu = (restoreFocus = false) => {
				if (!currencyMenu || !currencyTrigger) return;
				currencyMenu.hidden = true;
				currencyTrigger.setAttribute('aria-expanded', 'false');
				if (restoreFocus) currencyTrigger.focus();
			};
			const openCurrencyMenu = () => {
				if (!currencyMenu || !currencyTrigger) return;
				currencyMenu.hidden = false;
				currencyTrigger.setAttribute('aria-expanded', 'true');
				Array.from(currencyOptions).find((option) => option.getAttribute('aria-checked') === 'true')?.focus();
			};
			currencyTrigger?.addEventListener('click', () => {
				currencyTrigger.getAttribute('aria-expanded') === 'true' ? closeCurrencyMenu() : openCurrencyMenu();
			});
			currencyOptions.forEach((option, index) => {
				option.addEventListener('click', () => {
					if (!currencySelect) return;
					currencySelect.value = option.dataset.currencyOption ?? 'MYR';
					currencySelect.dispatchEvent(new Event('change', { bubbles: true }));
					closeCurrencyMenu(true);
				});
				option.addEventListener('keydown', (event) => {
					if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
					event.preventDefault();
					const nextIndex = event.key === 'Home'
						? 0
						: event.key === 'End'
							? currencyOptions.length - 1
							: (index + (event.key === 'ArrowDown' ? 1 : -1) + currencyOptions.length) % currencyOptions.length;
					currencyOptions[nextIndex]?.focus();
				});
			});
			currencyMenu?.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') {
					event.preventDefault();
					closeCurrencyMenu(true);
				}
			});
			document.addEventListener('click', (event) => {
				if (event.target instanceof Element && !event.target.closest('.currency-picker')) {
					closeCurrencyMenu();
				}
			});
			updateCurrencyControl();
			const formatPrice = (amount: number) => new Intl.NumberFormat('en-MY', {
				style: 'currency',
				currency: currentCurrency,
			}).format(amount);
			const updatePriceLabels = () => {
				document.querySelectorAll<HTMLElement>('[data-price-amount]').forEach((price) => {
					price.textContent = formatPrice(Number(price.dataset.priceAmount ?? 0));
				});
			};

			const bagTrigger = document.querySelector<HTMLButtonElement>('.bag-trigger');
			const bagPanel = document.querySelector<HTMLElement>('#bag-panel');
			const bagBackdrop = document.querySelector<HTMLElement>('.bag-backdrop');
			const bagCount = document.querySelector<HTMLElement>('#bag-count');
			const bagHeadingCount = document.querySelector<HTMLElement>('#bag-heading-count');
			const bagItems = document.querySelector<HTMLElement>('#bag-items');
			const bagEmpty = document.querySelector<HTMLElement>('#bag-empty');
			const bagSubtotal = document.querySelector<HTMLElement>('#bag-subtotal');
			const bagCloseButtons = document.querySelectorAll<HTMLElement>('[data-bag-close]');

			if (bagTrigger && bagPanel && bagBackdrop && bagCount && bagHeadingCount && bagItems && bagEmpty && bagSubtotal) {
				const catalog = JSON.parse(bagItems.dataset.projects ?? '[]') as { slug: string; title: string; price: number }[];
				let cartSlugs: string[] = [];
				let storageAvailable = true;

				try {
					const storedCart = localStorage.getItem('portfolio-shop-cart');
					const legacyCart = storedCart === null ? localStorage.getItem('portfolio-shop-saved') : null;
					cartSlugs = JSON.parse(storedCart ?? legacyCart ?? '[]') as string[];
					if (!Array.isArray(cartSlugs) || !cartSlugs.every((slug) => typeof slug === 'string')) {
						cartSlugs = [];
					}
				} catch {
					storageAvailable = false;
				}

				const save = () => {
					if (!storageAvailable) return;
					try {
						localStorage.setItem('portfolio-shop-cart', JSON.stringify(cartSlugs));
					} catch {
						storageAvailable = false;
						const hint = document.querySelector<HTMLElement>('.bag-hint');
						if (hint) hint.textContent = 'Your cart is available for this visit only; browser storage is unavailable.';
					}
				};

				const renderBag = () => {
					cartSlugs = cartSlugs.filter((slug, index) =>
						catalog.some((project) => project.slug === slug) && cartSlugs.indexOf(slug) === index,
					);
					bagCount.textContent = String(cartSlugs.length);
					bagHeadingCount.textContent = `(${cartSlugs.length})`;
					bagEmpty.hidden = cartSlugs.length > 0;
					bagItems.replaceChildren();
					let total = 0;

					for (const slug of cartSlugs) {
						const project = catalog.find((item) => item.slug === slug);
						if (!project) continue;
						total += project.price;
						const row = document.createElement('div');
						row.className = 'bag-item';
						const details = document.createElement('div');
						details.className = 'bag-item-details';
						const link = document.createElement('a');
						link.href = `/projects/${project.slug}/`;
						link.textContent = project.title;
						const price = document.createElement('span');
						price.className = 'bag-item-price';
						price.textContent = `${formatPrice(project.price)} · Free to peek`;
						details.append(link, price);
						const remove = document.createElement('button');
						remove.type = 'button';
						remove.className = 'bag-remove';
						remove.textContent = 'Remove';
						remove.setAttribute('aria-label', `Remove ${project.title} from cart`);
						remove.addEventListener('click', () => {
							cartSlugs = cartSlugs.filter((item) => item !== slug);
							save();
							renderBag();
							updateCartButtons();
						});
						row.append(details, remove);
						bagItems.append(row);
					}
					bagSubtotal.textContent = formatPrice(total);
					save();
				};

				const updateCartButtons = () => {
					document.querySelectorAll<HTMLButtonElement>('[data-cart-project]').forEach((button) => {
						const inCart = cartSlugs.includes(button.dataset.cartProject ?? '');
						button.setAttribute('aria-pressed', String(inCart));
						button.setAttribute('aria-label', `${inCart ? 'Remove' : 'Add'} ${catalog.find((project) => project.slug === button.dataset.cartProject)?.title ?? 'project'} ${inCart ? 'from' : 'to'} cart`);
						button.querySelector<HTMLElement>('.cart-add-label')!.textContent = inCart ? 'In cart' : 'Add to cart';
						button.querySelector<HTMLElement>('.cart-add-symbol')!.textContent = inCart ? '✓' : '+';
					});
				};

				const closeBag = () => {
					bagPanel.setAttribute('aria-hidden', 'true');
					bagPanel.setAttribute('inert', '');
					bagBackdrop.hidden = true;
					bagTrigger.setAttribute('aria-expanded', 'false');
					document.body.classList.remove('bag-open');
					bagTrigger.focus();
				};

				const openBag = () => {
					bagPanel.removeAttribute('inert');
					bagPanel.setAttribute('aria-hidden', 'false');
					bagBackdrop.hidden = false;
					bagTrigger.setAttribute('aria-expanded', 'true');
					document.body.classList.add('bag-open');
					bagPanel.querySelector<HTMLButtonElement>('.icon-button')?.focus();
				};

				bagTrigger.addEventListener('click', () => {
					bagTrigger.getAttribute('aria-expanded') === 'true' ? closeBag() : openBag();
				});
				bagCloseButtons.forEach((button) => button.addEventListener('click', closeBag));
				document.addEventListener('keydown', (event) => {
					if (event.key === 'Escape' && bagTrigger.getAttribute('aria-expanded') === 'true') closeBag();
				});
				document.querySelectorAll<HTMLButtonElement>('[data-cart-project]').forEach((button) => {
					button.addEventListener('click', () => {
						const slug = button.dataset.cartProject;
						if (!slug) return;
						cartSlugs = cartSlugs.includes(slug)
							? cartSlugs.filter((item) => item !== slug)
							: [...cartSlugs, slug];
						save();
						renderBag();
						updateCartButtons();
					});
				});

				currencySelect?.addEventListener('change', () => {
					currentCurrency = currencySelect.value;
					updateCurrencyControl();
					try {
						localStorage.setItem('portfolio-shop-currency', currentCurrency);
					} catch {
						currencySelect.title = 'Currency preference could not be saved in this browser.';
					}
					updatePriceLabels();
					renderBag();
				});

				updatePriceLabels();
				renderBag();
				updateCartButtons();
			}
		</script>
	</body>
</html>
