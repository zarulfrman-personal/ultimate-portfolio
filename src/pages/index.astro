---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { Button } from '@starwind-ui/astro/button';
import { portfolio, projects } from '../data/portfolio';
import { Image } from 'astro:assets';

const featuredProject = projects.find((project) => project.featured) ?? projects[0];
const otherProjects = projects.filter((project) => project.slug !== featuredProject.slug);
const categories = [...new Set(projects.map((project) => project.category))];
---

<Layout>
	<section class="hero">
		<div class="hero-copy">
			<p class="eyebrow"><span class="status-dot"></span> {portfolio.availability}</p>
			<h1>Welcome to Zarul's<br /><span>little bodega.</span></h1>
			<p class="hero-intro">{portfolio.introduction}</p>
			<div class="hero-actions">
				<a class="button button-dark" href="#catalog">Explore selected work <span aria-hidden="true">↓</span></a>
				<a class="text-link" href="/about/">A little about me <span aria-hidden="true">↗</span></a>
			</div>
			<div class="hero-disciplines" aria-label="Areas of work">
				<span>SOFTWARE</span><span>CONNECTED SYSTEMS</span><span>DATA</span>
			</div>
		</div>
		<a class:list={['hero-feature', `art-${featuredProject.color}`]} href={`/projects/${featuredProject.slug}/`}>
			<span class="feature-sticker">ON THE SHELF <b aria-hidden="true">✳</b></span>
			<span class="feature-label">THE FEATURED FIND <span aria-hidden="true">{featuredProject.mark} — {String(projects.length).padStart(2, '0')}</span></span>
			{featuredProject.previewImage && (
				<Image
					class="feature-image"
					src={featuredProject.previewImage}
					alt={featuredProject.previewAlt}
					fetchpriority="high"
				/>
			)}
			<span class="feature-bottom">
				<span><small>{featuredProject.category.toUpperCase()}</small><strong>{featuredProject.title}</strong></span>
				<span class="feature-arrow" aria-hidden="true">↗</span>
			</span>
		</a>
	</section>

	<section class="ticker" aria-label="Portfolio note">
		<div class="ticker-track" aria-hidden="true">
			<div class="ticker-set"><span>SELECTED PROJECTS</span><b>✳</b><span>SOFTWARE &amp; SYSTEMS</span><b>✳</b><span>BUILT WITH CURIOSITY</span><b>✳</b></div>
			<div class="ticker-set"><span>SELECTED PROJECTS</span><b>✳</b><span>SOFTWARE &amp; SYSTEMS</span><b>✳</b><span>BUILT WITH CURIOSITY</span><b>✳</b></div>
		</div>
	</section>

	<section class="catalog section-wrap" id="catalog">
		<div class="section-heading">
			<div>
				<p class="eyebrow">A SELECTION OF PROJECTS <span class="heading-count">0{projects.length}</span></p>
				<h2>Selected <span>work.</span></h2>
			</div>
			<p class="section-aside">From connected campus transport to machine learning, each project is a different kind of problem to get curious about.</p>
		</div>
		<div class="catalog-toolbar">
			<div class="filter-list" role="group" aria-label="Filter projects by category">
				<Button.Root class="filter-button is-active" type="button" data-filter="all" aria-pressed="true">Everything <span>{projects.length}</span></Button.Root>
				{categories.map((category) => (
					<Button.Root class="filter-button" type="button" data-filter={category} aria-pressed="false">{category}</Button.Root>
				))}
			</div>
			<div class="catalog-tools">
				<label class="project-search">
					<span class="visually-hidden">Search projects</span>
					<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 4.5 4.5"></path></svg>
					<input type="search" id="project-search" placeholder="Search the shelves..." autocomplete="off" />
				</label>
				<p class="bag-caption"><span aria-hidden="true">＋</span> Add a project to your cart</p>
			</div>
		</div>

		<div class="product-grid">
			{featuredProject && <ProductCard project={featuredProject} />}
			{otherProjects.map((project) => <ProductCard project={project} />)}
		</div>
		<p class="catalog-results" id="catalog-results" aria-live="polite" aria-atomic="true"></p>
		<p class="catalog-empty" hidden>No projects found. Try another search or choose Everything.</p>
	</section>

	<section class="about-strip">
		<div class="about-stamp" aria-hidden="true">BASED IN<br />PENANG <span>↘</span></div>
		<div class="about-strip-copy">
			<p class="eyebrow">A LITTLE CONTEXT</p>
			<h2>Good work starts<br /><span>with curiosity.</span></h2>
			<p>I’m {portfolio.name}, a {portfolio.role.toLowerCase()} based in {portfolio.location}. I enjoy working across the layers that make a useful product possible—from the interface to the systems behind it.</p>
			<a class="text-link" href="/about/">Get to know me <span aria-hidden="true">↗</span></a>
		</div>
		<div class="about-doodle" aria-hidden="true">✳</div>
	</section>

	<script>
		const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
		const productCards = document.querySelectorAll<HTMLElement>('.product-card');
		const catalogEmpty = document.querySelector<HTMLElement>('.catalog-empty');
		const projectSearch = document.querySelector<HTMLInputElement>('#project-search');
		const catalogResults = document.querySelector<HTMLElement>('#catalog-results');
		let activeCategory = 'all';

		filterButtons.forEach((button) => {
			button.addEventListener('click', () => {
				activeCategory = button.dataset.filter ?? 'all';
				filterButtons.forEach((filter) => {
					const active = filter === button;
					filter.classList.toggle('is-active', active);
					filter.setAttribute('aria-pressed', String(active));
				});
				updateCatalog();
			});
		});

		const updateCatalog = () => {
			const query = projectSearch?.value.trim().toLocaleLowerCase() ?? '';
			let visibleCount = 0;
			productCards.forEach((card) => {
				const matchesCategory = activeCategory === 'all' || card.dataset.category === activeCategory;
				const matchesQuery = (card.dataset.search ?? '').toLocaleLowerCase().includes(query);
				const matches = matchesCategory && matchesQuery;
				card.hidden = !matches;
				if (matches) visibleCount += 1;
			});
			if (catalogEmpty) catalogEmpty.hidden = visibleCount > 0;
			if (catalogResults) {
				catalogResults.textContent = query || activeCategory !== 'all'
					? `${visibleCount} ${visibleCount === 1 ? 'project' : 'projects'} found`
					: '';
			}
		};

		projectSearch?.addEventListener('input', updateCatalog);
	</script>
</Layout>
